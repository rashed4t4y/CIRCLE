{
  "name": "circle-social-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c magenta,cyan \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server run start",
    "db:migrate": "node server/db/migrate.js",
    "db:seed": "node server/db/seed.js",
    "test": "node --test --test-concurrency=1 server/test/*.test.js",
    "test:api": "node --test --test-concurrency=1 server/test/api.test.js",
    "postinstall": "node scripts/install.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "supertest": "^7.1.4"
  }
}
