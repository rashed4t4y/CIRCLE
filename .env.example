# Copy to .env and replace every placeholder. Never commit .env.
DATABASE_URL=postgresql://circle_app:REPLACE_WITH_DATABASE_PASSWORD@localhost:5432/circle
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
SERVER_ORIGIN=http://localhost:3001
NODE_ENV=development
# Only used by the opt-in demo seed. Use at least 12 characters.
DEMO_PASSWORD=REPLACE_WITH_DEMO_PASSWORD
# Optional: separate disposable database for integration tests.
TEST_DATABASE_URL=postgresql://circle_app:REPLACE_WITH_DATABASE_PASSWORD@localhost:5432/circle_test
# Optional: set true for a remote PostgreSQL service with a trusted TLS certificate.
# Keep false for the local PostgreSQL setup in the README.
DATABASE_SSL=false
